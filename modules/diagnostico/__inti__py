# FIN 8.1
# ===============================================================


# ===============================================================
# 8.2 — VERIFICAR
# ===============================================================

def verificar(engine: Any = None, **kwargs: Any) -> Dict[str, Any]:
    """Capacidad de compuerta: informe de solo lectura."""
    out = censo(engine, **kwargs)
    if isinstance(out, dict):
        out = dict(out)
        out["coherente"] = True  # DG no invalida arranque; solo observa
    return out

