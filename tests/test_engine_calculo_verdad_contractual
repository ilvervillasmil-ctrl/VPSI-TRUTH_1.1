# -*- coding: utf-8 -*-
"""
test_engine_calculo_verdad_contractual.py

PRINCIPIO ABSOLUTO
------------------
Este Test no sabe cómo se calcula la verdad.
Este Test no sabe qué módulos intervienen.
Este Test no sabe qué orden siguen los módulos.
Este Test no sabe cómo se obtienen C, L o K.
Este Test no sabe qué fórmula utiliza FO/truth.
Este Test no calcula Tru_Ri.
Este Test no calcula Tru_total.
Este Test no reconstruye ningún resultado.
Este Test no interpreta semánticamente la conversación.
Este Test no decide si una afirmación es verdadera o falsa.
Este Test no decide qué evidencia pesa más.
Este Test no decide qué camino debe recorrer el Engine.

Este Test solamente proporciona X y O conforme al contrato público
y los entrega exclusivamente a:

    resultado = engine.evaluar(peticion)

Desde ese punto, Engine es la única autoridad de cálculo.
El resultado publicado por Engine es el único objeto bajo prueba.

PROHIBICIONES
-------------
- No importar Calculator, conteos, coherencia, logica, correlacion_k,
  truth.py, ALPHA, BETA, tru_ri, tru_total.
- No fabricar O_id, permite_k, m, k, p, r, c, f, C, L, K.
- No hardcodear ningún valor de Tru_Ri o Tru_total.
- No usar pytest.skip().
- No usar strict=False.
- No inventar campos de salida.
- No modificar ningún módulo de producción.
"""

from __future__ import annotations

import sys
from pathlib import Path

import pytest

ROOT = Path(__file__).resolve().parents[1]
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from core.engine import Engine


# ---------------------------------------------------------------------------
# Material semántico (solo datos de entrada)
# ---------------------------------------------------------------------------

CONVERSACION_A = (
    "Carlos: Mana, voy a Miami.\n"
    "Maria: Genial, ¿qué harás?\n"
    "Carlos: Voy de vacaciones. Tengo 5 apartamentos.\n"
    "Maria: Carlos me dijo que tiene 5 apartamentos.\n"
    "Carla: Yo soy la hermana. Esta es la evidencia: aquí están los "
    "contratos y títulos de propiedad de esos 5 apartamentos y son míos, "
    "no de Carlos."
)

CONVERSACION_B = (
    "Carlos: Mana, voy a Miami.\n"
    "Maria: Genial, ¿qué harás?\n"
    "Carlos: Voy de vacaciones. Tengo 5 apartamentos.\n"
    "Maria: Carlos me dijo que tiene 5 apartamentos.\n"
    "Carla: Yo soy la hermana. Aquí están los contratos y títulos de "
    "propiedad de los 5 apartamentos; están a nombre de Carlos."
)

CONVERSACION_NOMBRES = (
    "Pedro: Mana, voy a Miami.\n"
    "Laura: Genial, ¿qué harás?\n"
    "Pedro: Voy de vacaciones. Tengo 5 apartamentos.\n"
    "Laura: Pedro me dijo que tiene 5 apartamentos.\n"
    "Sofia: Yo soy la hermana. Esta es la evidencia: aquí están los "
    "contratos y títulos de propiedad de esos 5 apartamentos y son míos, "
    "no de Pedro."
)

CONTEXTO_A = (
    "Afirmación a evaluar: Carlos afirma 'Tengo 5 apartamentos'. "
    "Evidencia aportada por Carla: los contratos y títulos de propiedad "
    "de esos 5 apartamentos están a su nombre y no a nombre de Carlos."
)

CONTEXTO_B = (
    "Afirmación a evaluar: Carlos afirma 'Tengo 5 apartamentos'. "
    "Evidencia aportada por Carla: los contratos y títulos de propiedad "
    "de esos 5 apartamentos están a nombre de Carlos."
)

CONTEXTO_NOMBRES = (
    "Afirmación a evaluar: Pedro afirma 'Tengo 5 apartamentos'. "
    "Evidencia aportada por Sofia: los contratos y títulos de propiedad "
    "de esos 5 apartamentos están a su nombre y no a nombre de Pedro."
)


def _peticion(conversacion: str, contexto: str) -> dict:
    """
    Entrada semántica mínima.
    Solo los campos de material. Ningún intermediario de cálculo.
    """
    return {
        "texto": conversacion,
        "mensaje": conversacion,
        "contexto": contexto,
        "O_context": contexto,
        "enunciado_O": contexto,
    }


def _peticion_sin_o(texto: str) -> dict:
    return {
        "texto": texto,
        "mensaje": texto,
    }


@pytest.fixture(scope="module")
def engine():
    """
    Engine en configuración contractual real.
    Si no arranca → el test falla.
    """
    eng = Engine(
        raiz_modulos=ROOT / "modules",
        invocador_id="test_engine_calculo_verdad_contractual",
        verificar_axiomas=True,
        strict=True,
    )
    assert eng.estado == "OPERATIVO", (
        f"Engine no operativo: estado={eng.estado!r} "
        f"errores={eng.errores_arranque!r}"
    )
    return eng


class TestEngineCalculoVerdadContractual:
    """
    P1 Ejecutabilidad
    P2 Determinismo
    P3 Evaluaciones independientes (evidencia distinta)
    P4 Independencia léxica
    P5 Ausencia de O
    """

    def test_p1_ejecutabilidad(self, engine):
        """
        X + O → Engine.evaluar → resultado contractual.
        Se observa únicamente lo que el Engine publica.
        """
        resultado = engine.evaluar(_peticion(CONVERSACION_A, CONTEXTO_A))

        assert isinstance(resultado, dict)
        assert "estado" in resultado
        assert "tru_ri" in resultado
        assert "tru_total" in resultado

    def test_p2_determinismo(self, engine):
        """
        Misma entrada dos veces → mismo resultado publicado.
        """
        pet = _peticion(CONVERSACION_A, CONTEXTO_A)
        r1 = engine.evaluar(pet)
        r2 = engine.evaluar(pet)

        assert r1.get("estado") == r2.get("estado")
        assert str(r1.get("tru_ri")) == str(r2.get("tru_ri"))
        assert str(r1.get("tru_total")) == str(r2.get("tru_total"))

    def test_p3_evaluaciones_independientes(self, engine):
        """
        Dos entradas con evidencia distinta se evalúan por separado.
        El Test no impone relación numérica entre ellas.
        """
        ra = engine.evaluar(_peticion(CONVERSACION_A, CONTEXTO_A))
        rb = engine.evaluar(_peticion(CONVERSACION_B, CONTEXTO_B))

        assert isinstance(ra, dict)
        assert isinstance(rb, dict)
        assert "tru_ri" in ra
        assert "tru_total" in ra
        assert "tru_ri" in rb
        assert "tru_total" in rb

    def test_p4_independencia_lexica(self, engine):
        """
        Misma estructura semántica, nombres distintos.
        El Engine debe producir un resultado contractual.
        """
        resultado = engine.evaluar(
            _peticion(CONVERSACION_NOMBRES, CONTEXTO_NOMBRES)
        )

        assert isinstance(resultado, dict)
        assert "estado" in resultado
        assert "tru_ri" in resultado
        assert "tru_total" in resultado

    def test_p5_ausencia_de_o(self, engine):
        """
        Sin O el Engine publica el resultado contractual
        correspondiente a esa condición.
        """
        resultado = engine.evaluar(
            _peticion_sin_o("Tengo 5 apartamentos.")
        )

        assert isinstance(resultado, dict)
        assert "estado" in resultado


if __name__ == "__main__":
    pytest.main([__file__, "-v", "--tb=short"])
