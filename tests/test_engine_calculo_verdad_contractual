)

CONTEXTO_NOMBRES = (
    "Afirmación a evaluar: Pedro afirma 'Tengo 5 apartamentos'. "
    "Evidencia aportada por Sofia: los contratos y títulos de propiedad "
    "de esos 5 apartamentos están a su nombre y no a nombre de Pedro."
)


# ===========================================================================
# CONSTRUCCIÓN DE ENTRADA
# ===========================================================================
#
# Esta función solamente empaqueta material semántico.
#
# No contiene:
#   C, L, K
#   conteos
#   factores
#   resultados
#   O_id
#   permite_k
#   parámetros de cálculo
#
# Engine recibe la información y decide internamente cómo procesarla.
# ===========================================================================

def _peticion(conversacion: str, contexto: str) -> dict:
    return {
        "texto": conversacion,
        "mensaje": conversacion,
        "contexto": contexto,
        "O_context": contexto,
        "enunciado_O": contexto,
    }


def _peticion_sin_o(texto: str) -> dict:
    return {
        "texto": texto,
        "mensaje": texto,
    }


# ===========================================================================
# INSPECCIÓN MÍNIMA DEL RESULTADO
# ===========================================================================
#
# Esta función NO valida el contenido matemático.
#
# Solamente verifica que un campo contractual fue publicado.
#
# No convierte a Fraction.
# No compara contra un número.
# No conoce una fórmula.
# No establece un rango.
# No determina si el valor es correcto.
#
# La corrección del valor pertenece exclusivamente al productor.
# ===========================================================================

def _campo_publicado(resultado: dict, campo: str) -> bool:
    if campo not in resultado:
        return False

    return resultado[campo] is not None


