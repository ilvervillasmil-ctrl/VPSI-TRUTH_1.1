# ===========================================================================
# CONSTRUCCIÓN DE PETICIÓN
# ===========================================================================

def _peticion(conversacion: str, contexto: str) -> dict:
    """
    NOTA DE IMPLEMENTACIÓN
    ----------------------
    Se entregan únicamente los campos de entrada semántica reconocidos
    por el contrato de Engine.evaluar.

    No se inyectan factores, conteos, O_id, permite_k ni resultados
    intermedios.

    No se fija unilateralmente escala_id="tru_conversacion".
    El Engine decide el alcance de evaluación conforme a sus contratos
    y a las capacidades de escala que tenga cargadas.
    Si el Engine requiere un campo de escala, lo resolverá por sí mismo
    o devolverá el estado contractual correspondiente.
    """
    return {
        "texto": conversacion,
        "mensaje": conversacion,
        "descripcion": conversacion,
        "contexto": contexto,
        "O_context": contexto,
        "enunciado_O": contexto,
        "metodo": "operacional",
    }


def _peticion_sin_o(texto: str) -> dict:
    """
    NOTA: caso contractual separado (ausencia de O).
    No se usa para suavizar los casos principales.
    """
    return {
        "texto": texto,
        "mensaje": texto,
        "metodo": "operacional",
    }


# ===========================================================================
# HELPERS MÍNIMOS DE INSPECCIÓN (solo forma publicada)
# ===========================================================================

def _tiene_cuantificacion(resultado: dict, campo: str) -> bool:
    """
    NOTA DE IMPLEMENTACIÓN
    ----------------------
    Comprueba únicamente que el Engine publicó el campo y que el valor
    no es None ni la marca de indefinido.

    No convierte a Fraction.
    No aplica ninguna fórmula.
    No conoce el número correcto.
    No inventa un micro-contrato de representación.
    """
    if campo not in resultado:
        return False
    valor = resultado[campo]
    if valor is None:
        return False
    texto = str(valor).strip()
    if not texto:
        return False
    if texto.upper() in ("UNDEFINED", "NONE", "NULL", "∅"):
        return False
    return True


