class TestEngineCalculoVerdadContractual:
    """
    NOMBRE DE LA CLASE
    ------------------
    TestEngineCalculoVerdadContractual

    PROPIEDADES QUE SE VERIFICAN
    ----------------------------
    A. Capacidad de cálculo
    B. Sensibilidad a cambio de evidencia (evaluaciones independientes)
    C. Independencia léxica (nombres distintos)
    D. Determinismo
    E. Restricción contractual sin O
    """

    # ------------------------------------------------------------------
    # A — Capacidad de cálculo
    # ------------------------------------------------------------------
    def test_a_capacidad_de_calculo(self, engine):
        """
        NOMBRE: test_a_capacidad_de_calculo

        PROPOSICIÓN
        -----------
        El Engine, ante conversación + contexto válido, publica
        Tru_Ri y Tru_total como resultado de su capacidad contractual.

        No se acepta:
          PARCIAL, UNDEFINED, ERROR, RECHAZADO,
          ausencia de tru_ri, ausencia de tru_total,
          valores indefinidos.
        """
        pet = _peticion(CONVERSACION_A, CONTEXTO_A)
        resultado = engine.evaluar(pet)

        assert isinstance(resultado, dict), (
            "Engine.evaluar debe devolver un dict"
        )
        assert resultado.get("estado") == "OK", (
            "Se exige estado OK cuando la entrada es contractual. "
            f"Recibido estado={resultado.get('estado')!r} "
            f"razon={resultado.get('razon')!r}"
        )
        assert _tiene_cuantificacion(resultado, "tru_ri"), (
            "El Engine debe publicar Tru_Ri cuantificado. "
            f"Valor: {resultado.get('tru_ri')!r}"
        )
        assert _tiene_cuantificacion(resultado, "tru_total"), (
            "El Engine debe publicar Tru_total cuantificado. "
            f"Valor: {resultado.get('tru_total')!r}"
        )

    # ------------------------------------------------------------------
    # B — Sensibilidad semántica (evidencia invertida)
    # ------------------------------------------------------------------
    def test_b_sensibilidad_evidencia_invertida(self, engine):
        """
        NOMBRE: test_b_sensibilidad_evidencia_invertida

        PROPOSICIÓN
        -----------
        Dos entradas con evidencia semánticamente distinta producen
        dos evaluaciones independientes y cuantificadas.

        NOTA:
        El Test no impone qué número debe salir en cada caso.
        No escribe assert A != B con un umbral inventado.
        Solo exige:
          - ambas ejecuciones publican Tru_Ri y Tru_total
          - ambas son evaluaciones reales (estado OK)
          - los resultados se obtuvieron de llamadas independientes
            a engine.evaluar (no se reutiliza un valor anterior)
        """
        ra = engine.evaluar(_peticion(CONVERSACION_A, CONTEXTO_A))
        rb = engine.evaluar(_peticion(CONVERSACION_B, CONTEXTO_B))

        assert ra.get("estado") == "OK", (
            f"Caso A debe ser OK. Recibido: {ra.get('estado')!r}"
        )
        assert rb.get("estado") == "OK", (
            f"Caso B debe ser OK. Recibido: {rb.get('estado')!r}"
        )
        assert _tiene_cuantificacion(ra, "tru_ri")
        assert _tiene_cuantificacion(ra, "tru_total")
        assert _tiene_cuantificacion(rb, "tru_ri")
        assert _tiene_cuantificacion(rb, "tru_total")

        # Las dos evaluaciones son objetos distintos (llamadas independientes)
        assert ra is not rb

    # ------------------------------------------------------------------
    # C — Independencia léxica
    # ------------------------------------------------------------------
    def test_c_independencia_lexica(self, engine):
        """
        NOMBRE: test_c_independencia_lexica

        PROPOSICIÓN
        -----------
        La misma estructura semántica con nombres distintos
        (Pedro / Laura / Sofia) produce una evaluación contractual válida.
        No debe existir dependencia de los nombres literales del ejemplo.
        """
        resultado = engine.evaluar(
            _peticion(CONVERSACION_NOMBRES, CONTEXTO_NOMBRES)
        )

        assert resultado.get("estado") == "OK", (
            "Cambio de nombres no debe impedir la evaluación. "
            f"Recibido: {resultado.get('estado')!r}"
        )
        assert _tiene_cuantificacion(resultado, "tru_ri")
        assert _tiene_cuantificacion(resultado, "tru_total")

    # ------------------------------------------------------------------
    # D — Determinismo
    # ------------------------------------------------------------------
    def test_d_determinismo(self, engine):
        """
        NOMBRE: test_d_determinismo

        PROPOSICIÓN
        -----------
        Misma entrada + misma configuración → misma cuantificación
        publicada.

        Esta prueba demuestra determinismo.
        No sustituye la prueba de capacidad de cálculo.
        Un valor constante también sería determinista; por eso
        esta propiedad es secundaria y complementaria a A y B.
        """
        pet = _peticion(CONVERSACION_A, CONTEXTO_A)

        r1 = engine.evaluar(pet)
        r2 = engine.evaluar(pet)

        assert r1.get("estado") == "OK"
        assert r2.get("estado") == "OK"
        assert _tiene_cuantificacion(r1, "tru_ri")
        assert _tiene_cuantificacion(r1, "tru_total")
        assert _tiene_cuantificacion(r2, "tru_ri")
        assert _tiene_cuantificacion(r2, "tru_total")

        assert str(r1["tru_ri"]) == str(r2["tru_ri"]), (
            "Tru_Ri debe ser idéntico en dos ejecuciones iguales. "
            f"r1={r1['tru_ri']!r} r2={r2['tru_ri']!r}"
        )
        assert str(r1["tru_total"]) == str(r2["tru_total"]), (
            "Tru_total debe ser idéntico en dos ejecuciones iguales. "
            f"r1={r1['tru_total']!r} r2={r2['tru_total']!r}"
        )

    # ------------------------------------------------------------------
    # E — Ausencia de O (restricción contractual)
    # ------------------------------------------------------------------
    def test_e_sin_o_no_cuantifica(self, engine):
        """
        NOMBRE: test_e_sin_o_no_cuantifica

        PROPOSICIÓN
        -----------
        Sin O usable el Engine no debe publicar Tru_Ri ni Tru_total
        cuantificados (restricción Def-5.3.1).

        Esta prueba es independiente y no suaviza A-D.
        """
        resultado = engine.evaluar(
            _peticion_sin_o("Tengo 5 apartamentos.")
        )

        assert isinstance(resultado, dict)
        estado = str(resultado.get("estado", "")).upper()
        assert estado == "UNDEFINED", (
            "Sin O se exige estado UNDEFINED. "
            f"Recibido: {estado!r}"
        )
        assert not _tiene_cuantificacion(resultado, "tru_total"), (
            "Sin O no debe publicarse Tru_total cuantificado. "
            f"Valor: {resultado.get('tru_total')!r}"
        )
        assert not _tiene_cuantificacion(resultado, "tru_ri"), (
            "Sin O no debe publicarse Tru_Ri cuantificado. "
            f"Valor: {resultado.get('tru_ri')!r}"
        )


