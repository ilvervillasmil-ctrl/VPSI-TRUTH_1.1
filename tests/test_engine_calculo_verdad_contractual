# ===========================================================================
# SUITE DE INTEGRACIÓN
# ===========================================================================

class TestEngineCalculoVerdadContractual:
    """
    Prueba de caja negra del Engine.

    Ningún método de esta clase calcula verdad.

    Ningún método conoce la fórmula.

    Ningún método genera resultados esperados.

    Todos los resultados observados proceden exclusivamente de:

        engine.evaluar(...)
    """

    # -----------------------------------------------------------------------
    # P1 — EJECUTABILIDAD
    # -----------------------------------------------------------------------

    def test_p1_ejecutabilidad(self, engine):
        """
        X + O
            |
            v
        Engine.evaluar()
            |
            v
        resultado publicado

        El Test no determina qué sucede internamente.
        Solo verifica que la interfaz de evaluación respondió.
        """

        peticion = _peticion(
            CONVERSACION_A,
            CONTEXTO_A,
        )

        resultado = engine.evaluar(peticion)

        assert isinstance(resultado, dict), (
            "Engine.evaluar() debe publicar un resultado contractual "
            "representado por un diccionario."
        )

        assert "estado" in resultado, (
            "El resultado del Engine debe publicar su estado contractual."
        )

        assert "tru_ri" in resultado, (
            "El resultado del Engine debe publicar Tru_Ri."
        )

        assert "tru_total" in resultado, (
            "El resultado del Engine debe publicar Tru_total."
        )

    # -----------------------------------------------------------------------
    # P2 — DETERMINISMO
    # -----------------------------------------------------------------------

    def test_p2_determinismo(self, engine):
        """
        Misma entrada + misma configuración + misma autoridad
        ------------------------------------------------------
        debe producir la misma publicación.

        El Test no calcula cuál debe ser el resultado.

        Solamente compara las dos publicaciones producidas por Engine.
        """

        peticion = _peticion(
            CONVERSACION_A,
            CONTEXTO_A,
        )

        resultado_1 = engine.evaluar(peticion)
        resultado_2 = engine.evaluar(peticion)

        assert isinstance(resultado_1, dict)
        assert isinstance(resultado_2, dict)

        assert resultado_1.get("estado") == resultado_2.get("estado"), (
            "La misma entrada no puede producir estados publicados "
            "diferentes bajo la misma configuración."
        )

        assert str(resultado_1.get("tru_ri")) == str(
            resultado_2.get("tru_ri")
        ), (
            "La misma entrada debe producir la misma publicación de Tru_Ri."
        )

        assert str(resultado_1.get("tru_total")) == str(
            resultado_2.get("tru_total")
        ), (
            "La misma entrada debe producir la misma publicación "
            "de Tru_total."
        )

    # -----------------------------------------------------------------------
    # P3 — EJECUCIONES INDEPENDIENTES
    # -----------------------------------------------------------------------

    def test_p3_ejecuciones_independientes(self, engine):
        """
        Dos entradas distintas son entregadas independientemente al Engine.

        El Test NO determina:
            resultado_A > resultado_B
            resultado_A < resultado_B
            resultado_A != resultado_B
            ninguna otra relación numérica.

        Esa relación, si existe y si el contrato la exige, pertenece
        exclusivamente al cálculo productivo.

        El único hecho que este Test demuestra es que ambas entradas fueron
        evaluadas mediante llamadas independientes a Engine.evaluar().
        """

        resultado_a = engine.evaluar(
            _peticion(
                CONVERSACION_A,
                CONTEXTO_A,
            )
        )

        resultado_b = engine.evaluar(
            _peticion(
                CONVERSACION_B,
                CONTEXTO_B,
            )
        )

        assert isinstance(resultado_a, dict)
        assert isinstance(resultado_b, dict)

        assert "estado" in resultado_a
        assert "estado" in resultado_b

        assert "tru_ri" in resultado_a
        assert "tru_total" in resultado_a

        assert "tru_ri" in resultado_b
        assert "tru_total" in resultado_b

        assert resultado_a is not resultado_b

    # -----------------------------------------------------------------------
    # P4 — VARIACIÓN LÉXICA
    # -----------------------------------------------------------------------

    def test_p4_variacion_lexica(self, engine):
        """
        Se presenta al mismo Engine una entrada con identidades léxicas
        diferentes.

        El Test no contiene ninguna regla sobre Carlos, Carla, Pedro,
        Laura o Sofia.

        No se compara ningún valor numérico.

        No se afirma que los resultados deban ser iguales o diferentes.

        Solamente se comprueba que la entrada puede recorrer la misma
        interfaz pública de evaluación.
        """

        resultado = engine.evaluar(
            _peticion(
                CONVERSACION_NOMBRES,
                CONTEXTO_NOMBRES,
            )
        )

        assert isinstance(resultado, dict)

        assert "estado" in resultado
        assert "tru_ri" in resultado
        assert "tru_total" in resultado

    # -----------------------------------------------------------------------
    # P5 — AUSENCIA DE O
    # -----------------------------------------------------------------------

    def test_p5_ausencia_de_o(self, engine):
        """
        Caso contractual separado.

        No se proporciona contexto O.

        El Test NO fabrica K.
        El Test NO decide el resultado matemático.
        El Test NO calcula Tru_Ri.
        El Test NO calcula Tru_total.

        Engine decide exclusivamente qué estado corresponde a esta entrada.

        La única comprobación específica es la condición contractual pública
        de ausencia de O: el Engine debe publicar el estado correspondiente
        a una evaluación sin dominio O.
        """

        resultado = engine.evaluar(
            _peticion_sin_o(
                "Tengo 5 apartamentos."
            )
        )

        assert isinstance(resultado, dict)

        assert "estado" in resultado

        estado = str(resultado.get("estado", "")).upper()

        assert estado == "UNDEFINED", (
            "Ante ausencia de O usable, el Engine debe publicar el "
            "estado contractual de indefinición. "
            f"Estado publicado: {estado!r}"
        )


